{
  "mcpServers": {
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git@latest", "--repository", "."],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": []
    },
    "hatchable": {
      "command": "mcp",
      "args": [],
      "transport": {
        "type": "http",
        "url": "https://hatchable.com/mcp"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}